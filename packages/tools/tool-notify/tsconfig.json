{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    // 本包是双面孔：host 半边用 node:child_process（types: node 继承自 base），
    // client 半边用浏览器 Notification / window / document，因此需要 DOM lib。
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../../vendor/schemastery"
    },
    {
      "path": "../../core/tools"
    },
    {
      "path": "../../api/session-controller/tsconfig.client.json"
    },
    {
      "path": "../../client/ui-session"
    },
    {
      "path": "../../client/ui-approval"
    }
  ]
}
